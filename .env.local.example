# Copy this file to .env.local for safe localhost payment testing.
# Never commit or share the completed .env.local file.
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Paste the matching TEST keys from Paystack Dashboard ->
# Settings -> API Keys & Webhooks -> Test Mode.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME

# Copy these three values from your existing .env so local orders can be
# recorded in Supabase and shown in the admin panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep empty to use Vite's localhost /api proxy.
VITE_API_URL=
