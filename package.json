{
  "name": "mani-beauty",
  "version": "1.0.0",
  "description": "Professional Beauty Salon Website",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/app.js",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "start": "tsx server/app.js",
    "preview": "vite preview",
    "sam:build": "sam build",
    "sam:local": "sam build && sam local start-api -t .aws-sam/build/template.yaml --port 3001",
    "sam:deploy": "sam build && sam deploy --template-file .aws-sam/build/template.yaml --guided",
    "migrate:supabase": "node scripts/migrate-to-supabase.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "db:create-schema": "node scripts/create-product-orders-table.mjs"
  },
  "keywords": [
    "beauty",
    "salon",
    "booking"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.263.1",
    "pg": "^8.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-paystack": "^6.0.0",
    "react-router-dom": "^6.30.1",
    "serverless-http": "^4.0.0",
    "vite": "^7.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "tsx": "^4.20.0"
  }
}
